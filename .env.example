# Casper Testnet Configuration

# Local proxy (must run: node cspr_proxy.js)
ODRA_CASPER_LIVENET_NODE_ADDRESS=http://127.0.0.1:7778
ODRA_CASPER_LIVENET_EVENTS_URL=http://127.0.0.1:7778/events

# Testnet chain name
ODRA_CASPER_LIVENET_CHAIN_NAME=casper-test

# CSPR.cloud API token (get from https://console.cspr.build/)
CSPR_CLOUD_AUTH_TOKEN=your-api-key-here

# Transaction TTL
ODRA_CASPER_LIVENET_TTL=30m
